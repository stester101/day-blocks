rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One document per person: users/{their uid}. Nobody can read or write anyone else's plans.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json', 'updated', 'dev'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }
  }
}
